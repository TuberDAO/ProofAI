# MegaETH testnet RPC URL (Chain ID: 6342)
# NOTE: MegaETH testnet endpoints are rate-limited and may change
# Check docs.megaeth.com for the latest endpoints
MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc

# Deployer wallet private key (without 0x prefix)
# IMPORTANT: Use a BURNER wallet for testnet ONLY - never reuse production keys
# This wallet needs testnet ETH for deployment gas fees
DEPLOYER_PRIVATE_KEY=your_private_key_here

