{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "types": ["node", "hardhat"],
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["hardhat.config.ts", "scripts/**/*.ts", "test/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "out", "cache", "broadcast"]
}

