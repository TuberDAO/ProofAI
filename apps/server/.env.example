# Server Configuration
PORT=4000

# MegaETH Testnet Configuration
MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc

# Signing Mode: "server" (dev) or "client" (production)
SIGNING_MODE=server

# Smart Contract Configuration
JOB_REGISTRY_ADDRESS=0xA2189Fc270BaaF85d57C04Bf8e00Cd6580aF0e07
JOB_REGISTRY_V2_ADDRESS=

# Server Wallet (ONLY required in server mode)
SERVER_WALLET_PRIVATE_KEY=
PROVIDER_ADDRESS=

# CORS
ALLOWED_ORIGIN=http://localhost:3000

# Limits
MIN_JOB_ETH=0.00001
MAX_JOB_ETH=0.01

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
