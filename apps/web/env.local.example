# Backend server URL (default: http://localhost:4000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# MegaETH testnet block explorer URL (Chain ID: 6342)
# NOTE: Explorer URLs may change - check docs.megaeth.com for updates
NEXT_PUBLIC_EXPLORER_BASE_URL=https://www.oklink.com/megaeth-testnet

# MegaETH Testnet Configuration
NEXT_PUBLIC_CHAIN_ID=6342
NEXT_PUBLIC_MEGAETH_RPC=https://carrot.megaeth.com/rpc
NEXT_PUBLIC_JOB_REGISTRY_V2_ADDRESS=0x9E4fA3B7f61b4eb19cD501e5f05514dfc024fA1E

# Signing Mode: 'client' (user signs with wallet) or 'server' (server signs - dev only)
# Set to 'client' for production-like behavior
NEXT_PUBLIC_SIGNING_MODE=client

# WalletConnect Project ID (optional - for WalletConnect support)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Session configuration (optional - defaults shown)
NEXT_PUBLIC_SESSION_DEFAULT_MINUTES=15
NEXT_PUBLIC_SESSION_MAX_MINUTES=30
