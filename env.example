# Server Configuration
PORT=8080
WEB_ORIGIN=http://localhost:3000

# Signing Mode: "server", "client", or session-based via x-session-id header
SIGNING_MODE=server

# Development Toggle: Mock blockchain operations (true = no real chain calls)
# Set to "false" for real MegaETH testnet integration
MOCK_ONCHAIN=true

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Blockchain Configuration (required when MOCK_ONCHAIN=false)
# MegaETH testnet v2 RPC endpoint (chainId 6343)
MEGAETH_RPC_URL=https://timothy.megaeth.com/rpc

# JobRegistry V1 contract address (deployed on MegaETH testnet v2)
# TODO: Set this after deploying with: cd packages/contracts && pnpm hh:deploy:megaeth
JOB_REGISTRY_ADDRESS=0x0862abCd451D710d857011C779C1CCe020e7cB6C

# Optional: JobRegistry V2 contract address (tracks submitter separately)
JOB_REGISTRY_V2_ADDRESS=

# Server Wallet (required when MOCK_ONCHAIN=false)
# Private key of wallet that pays gas for job submissions (with 0x prefix)
# This wallet must be funded with MegaETH testnet ETH
SERVER_WALLET_PRIVATE_KEY=0x...

# Provider Address (required when MOCK_ONCHAIN=false)
# Address that receives job submissions (can be same as server wallet)
# Typically your server wallet address or AI provider address
PROVIDER_ADDRESS=0x...

# Security Configuration
ALLOWED_CHAIN_IDS=6343
ALLOWED_CONTRACTS=
ALLOWED_MODELS=llama-3-8b-instruct

# Rate Limiting
RATE_LIMIT_BURST=60
WINDOW_SEC=60
MAX_REQS_PER_MINUTE=120
MAX_JOBS_PER_MINUTE=30

# Session Configuration
SESSION_DEFAULT_MINUTES=15
SESSION_MAX_MINUTES=30

# Optional: Job amount limits
MIN_JOB_ETH=0.00001
MAX_JOB_ETH=0.01

# Optional: Git commit (auto-filled in CI)
GIT_COMMIT=dev


