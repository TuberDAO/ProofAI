# Server Configuration
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Signing Mode: "server" or "client"
SIGNING_MODE=server

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Blockchain Configuration
MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc
JOB_REGISTRY_ADDRESS=0xA2189Fc270BaaF85d57C04Bf8e00Cd6580aF0e07
JOB_REGISTRY_V2_ADDRESS=0x9E4fA3B7f61b4eb19cD501e5f05514dfc024fA1E

# Server Wallet (required for SIGNING_MODE=server)
SERVER_WALLET_PRIVATE_KEY=0x...
PROVIDER_ADDRESS=0x...

# Security Configuration
ALLOWED_CHAIN_IDS=6342
ALLOWED_CONTRACTS=0xA2189Fc270BaaF85d57C04Bf8e00Cd6580aF0e07,0x9E4fA3B7f61b4eb19cD501e5f05514dfc024fA1E
ALLOWED_MODELS=llama-3-8b-instruct

# Rate Limiting
RATE_LIMIT_BURST=60
WINDOW_SEC=60
MAX_REQS_PER_MINUTE=120
MAX_JOBS_PER_MINUTE=30

# Session Configuration
SESSION_DEFAULT_MINUTES=15
SESSION_MAX_MINUTES=30

# Optional: Job amount limits
MIN_JOB_ETH=0.00001
MAX_JOB_ETH=0.01

# Optional: Git commit (auto-filled in CI)
GIT_COMMIT=dev


